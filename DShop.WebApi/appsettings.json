{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=DShop.db"
  },
  "urls": "http://*:9988",
  "FileStorage": {
    "BasePath": "D:/Uploads/"
  },
  "JWT": {
    "IssuerSigningKey": "DShop_SecurityKey_2024_YourSuperSecretKey!@#$",
    "ValidIssuer": "DShop",
    "ValidAudience": "DShop",
    "ExpiresHours": 12
  },
  "PluginHotReload": {
    "Enabled": true,
    "DebounceMilliseconds": 2000,
    "PluginDirectory": "Plugins"
  }
}
